{
  "info": {
    "name": "FinBot API",
    "description": "Complete test collection for FinBot SaaS — financial news intelligence API.\n\n**Setup:**\n1. Import `finbot.environment.json` and select it as active environment\n2. Run `POST /auth/register` to create an account\n3. Run `POST /auth/login` to get tokens (auto-saved to env)\n4. Run `POST /auth/keys` to create an API key (auto-saved to env)\n5. All subsequent requests use `{{apiKey}}` automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "description": "Returns 200 if the server is running. No auth required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has status field', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Registration, login, API key management. Tokens are automatically saved to environment variables.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trader@example.com\",\n  \"password\": \"StrongPass123!\",\n  \"name\": \"Test Trader\"\n}"
            },
            "description": "Create a new account. Returns user object with FREE plan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Has user id', () => {",
                  "  pm.expect(pm.response.json().data.id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (API key auth)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trader@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "description": "Login with email/password. Returns access + refresh tokens as HttpOnly cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "// Extract cookies if using cookie jar",
                  "const cookies = pm.cookies.toObject();",
                  "if (cookies.accessToken)  pm.environment.set('accessToken',  cookies.accessToken);",
                  "if (cookies.refreshToken) pm.environment.set('refreshToken', cookies.refreshToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard Login (JWT)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/dashboard/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"trader@example.com\",\n  \"password\": \"StrongPass123!\"\n}"
            },
            "description": "Login for dashboard UI. Sets HttpOnly accessToken + refreshToken cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/dashboard/refresh",
            "description": "Use the refresh token cookie to get a new access token. Requires valid refreshToken cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/dashboard/logout",
            "description": "Clears accessToken and refreshToken cookies."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "List API Keys",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/auth/keys",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "List all API keys for the authenticated user."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => {",
                  "  pm.expect(pm.response.json().data).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create API Key",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/keys",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Trading Bot\"\n}"
            },
            "description": "Create a new API key. The full key (fb_...) is only shown once — save it to the apiKey env variable immediately."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "if (body.data?.key) {",
                  "  pm.environment.set('apiKey', body.data.key);",
                  "  console.log('API key saved to environment:', body.data.key.slice(0,10) + '...');",
                  "}",
                  "if (body.data?.id) pm.environment.set('apiKeyId', body.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke API Key",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/auth/keys/{{apiKeyId}}",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Revoke an API key by ID. Uses {{apiKeyId}} set by the Create API Key request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "News",
      "description": "News feed, breaking news, and historical context comparison.",
      "item": [
        {
          "name": "List News",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/news?asset=BTC&limit=10&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "news"],
              "query": [
                { "key": "asset", "value": "BTC", "description": "Filter by asset (BTC, ETH, NVDA, AAPL...)" },
                { "key": "limit", "value": "10" },
                { "key": "page",  "value": "1" },
                { "key": "severity", "value": "high", "disabled": true, "description": "Filter: low | medium | high" }
              ]
            },
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Paginated news feed. Filterable by asset and severity."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Has articles array', () => pm.expect(body.data).to.be.an('array'));",
                  "// Save first article ID for context test",
                  "if (body.data?.length > 0) pm.environment.set('articleId', body.data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Breaking News",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/news/breaking?asset=BTC",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "news", "breaking"],
              "query": [
                { "key": "asset", "value": "BTC", "description": "Optional asset filter" }
              ]
            },
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Returns high-severity news from the last 24h. STARTER plan and above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('All items are high severity', () => {",
                  "  pm.response.json().data.forEach(item => {",
                  "    pm.expect(item.severity).to.eql('high');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Article by ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/news/{{articleId}}",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Fetch a single article by ID. Set {{articleId}} from the List News response."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has article fields', () => {",
                  "  const a = pm.response.json().data;",
                  "  pm.expect(a.id).to.be.a('string');",
                  "  pm.expect(a.title).to.be.a('string');",
                  "  pm.expect(a.asset).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Article Historical Context",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/news/{{articleId}}/context",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Vector-similarity search for past events similar to this article. Returns price outcomes (1d/7d/30d) for each historical match. PRO plan. Cached 30 min."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 402', () => {",
                  "  pm.expect([200, 402, 404]).to.include(pm.response.code);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test('Has similar events', () => pm.expect(body.data.similarEvents).to.be.an('array'));",
                  "  pm.test('Has pattern summary', () => pm.expect(body.data.patternSummary).to.be.an('object'));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Signal",
      "description": "Fast technical + sentiment signal engine. No LLM — computes in milliseconds.",
      "item": [
        {
          "name": "Get Signal — BTC",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/signal/BTC",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Composite signal for BTC: sentiment (35%) + RSI (25%) + MACD (18%) + BB (12%) + macro/FRED (10%). Returns outlook (bullish/neutral/bearish) + plain English summary. Cached 60s."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Has outlook not decision', () => {",
                  "  pm.expect(data.outlook).to.be.oneOf(['bullish', 'neutral', 'bearish']);",
                  "  pm.expect(data.decision).to.be.undefined;",
                  "});",
                  "pm.test('Score is in [-1, 1]', () => {",
                  "  pm.expect(data.score).to.be.at.least(-1).and.at.most(1);",
                  "});",
                  "pm.test('Has confidence', () => pm.expect(['low','medium','high']).to.include(data.confidence));",
                  "pm.test('Has summary', () => pm.expect(data.summary).to.be.a('string').and.not.empty);",
                  "pm.test('Has disclaimer', () => pm.expect(data.disclaimer).to.be.a('string').and.not.empty);",
                  "pm.test('Has components array', () => pm.expect(data.components).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Signal — NVDA",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/signal/NVDA",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Signal for a US stock. Same 5-component engine. Tests MACD normalisation with a real stock price."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Asset is NVDA', () => pm.expect(data.asset).to.eql('NVDA'));",
                  "pm.test('Score is numeric', () => pm.expect(data.score).to.be.a('number'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Signal — ETH",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/signal/ETH",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
