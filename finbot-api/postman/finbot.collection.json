    {
      "name": "Analysis (Deep — PRO)",
      "description": "Multi-agent TradingAgents analysis. Slow (30-120s). PRO plan only. Queued via BullMQ.",
      "item": [
        {
          "name": "Submit Analysis Job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/analysis",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset\": \"NVDA\",\n  \"date\": \"2026-03-20\"\n}"
            },
            "description": "Queue a deep multi-agent analysis. Returns jobId immediately. Poll /analysis/job/:jobId for results."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 202', () => pm.response.to.have.status(202));",
                  "const body = pm.response.json();",
                  "pm.test('Has jobId', () => pm.expect(body.data.jobId).to.be.a('string'));",
                  "pm.environment.set('jobId', body.data.jobId);",
                  "console.log('Job submitted:', body.data.jobId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Poll Job Status",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/analysis/job/{{jobId}}",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Poll for job result. Status: queued → active → completed | failed. Run every 10-15s until completed."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Has status', () => {",
                  "  pm.expect(['queued','active','completed','failed']).to.include(data.status);",
                  "});",
                  "console.log('Job status:', data.status);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Latest Analysis for Asset",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/analysis/latest/NVDA",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Fetch the most recent completed analysis for an asset."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 404', () => pm.expect([200, 404]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  pm.test('Has decision', () => pm.expect(['BUY','SELL','HOLD']).to.include(data.decision));",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
