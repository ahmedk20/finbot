    {
      "name": "Chat",
      "description": "AI chat grounded in FinBot's news + sentiment data.",
      "item": [
        {
          "name": "Chat — Ask about BTC",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"What is the current sentiment around Bitcoin and what are the key risks mentioned in recent news?\"\n    }\n  ],\n  \"asset\": \"BTC\"\n}"
            },
            "description": "LLM chat with context from FinBot's news data. STARTER plan and above."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Has content', () => pm.expect(data.content).to.be.a('string').and.not.empty);",
                  "pm.test('Has model used', () => pm.expect(data.model_used).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Chat — Multi-turn",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/chat",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"messages\": [\n    { \"role\": \"user\",      \"content\": \"What's the outlook for NVDA?\" },\n    { \"role\": \"assistant\", \"content\": \"NVIDIA shows moderately bullish signals based on recent earnings and AI demand...\" },\n    { \"role\": \"user\",      \"content\": \"What are the biggest risks?\" }\n  ],\n  \"asset\": \"NVDA\"\n}"
            },
            "description": "Multi-turn conversation. Pass full message history in the messages array."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Stream (SSE)",
      "description": "Server-Sent Events for real-time sentiment and news updates. Requires a short-lived stream token.",
      "item": [
        {
          "name": "Generate Stream Token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/stream/token",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Exchange your API key for a short-lived SSE token (valid ~60s). Use the token as ?token= query param in SSE endpoints."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.test('Has token', () => pm.expect(data.token).to.be.a('string'));",
                  "pm.environment.set('streamToken', data.token);",
                  "console.log('Stream token saved. Connect to SSE endpoints with ?token=' + data.token.slice(0,15) + '...');"
                ]
              }
            }
          ]
        },
        {
          "name": "SSE — Sentiment Stream (BTC)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stream/sentiment/BTC?token={{streamToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stream", "sentiment", "BTC"],
              "query": [{ "key": "token", "value": "{{streamToken}}" }]
            },
            "description": "SSE stream. Opens a persistent connection — use EventSource in browser or 'curl -N' in terminal.\n\ncurl -N '{{baseUrl}}/api/v1/stream/sentiment/BTC?token={{streamToken}}'\n\nSends updates when sentiment changes. Test by ingesting new articles."
          }
        },
        {
          "name": "SSE — News Stream (BTC)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/stream/news/BTC?token={{streamToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stream", "news", "BTC"],
              "query": [{ "key": "token", "value": "{{streamToken}}" }]
            },
            "description": "SSE stream for real-time news events for an asset. Triggers when news-scraper publishes a high-severity article via RabbitMQ → Redis pub/sub.\n\ncurl -N '{{baseUrl}}/api/v1/stream/news/BTC?token={{streamToken}}'"
          }
        }
      ]
    },
    {
      "name": "Webhooks",
      "description": "Register HTTP endpoints to receive push notifications on critical events.",
      "item": [
        {
          "name": "Create Webhook",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/webhooks",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-api-key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://webhook.site/your-unique-id\",\n  \"events\": [\"news_alert\"],\n  \"assets\": [\"BTC\", \"ETH\"]\n}"
            },
            "description": "Register a webhook endpoint. Use https://webhook.site to get a free test URL. events: news_alert | sentiment_shift. BUSINESS plan."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.test('Has webhook id', () => pm.expect(data.id).to.be.a('string'));",
                  "pm.environment.set('webhookId', data.id);",
                  "console.log('Webhook created:', data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Webhooks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/webhooks",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json().data).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Webhook",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/webhooks/{{webhookId}}",
            "header": [{ "key": "x-api-key", "value": "{{apiKey}}" }],
            "description": "Delete a webhook by ID. Uses {{webhookId}} set by Create Webhook."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
