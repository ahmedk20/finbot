    {
      "name": "Internal",
      "description": "Internal-only endpoints. Protected by X-Internal-Key header, not public API keys. Used by news-scraper to push sentiment scores.",
      "item": [
        {
          "name": "Ingest Article Sentiment",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/internal/sentiment/ingest",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Internal-Key", "value": "{{internalKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"articleId\": \"article-uuid-here\",\n  \"asset\": \"BTC\",\n  \"score\": 0.72,\n  \"label\": \"bullish\"\n}"
            },
            "description": "Called by news-scraper after FinBERT scores a new article. Pushes score into Redis for real-time aggregation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 401', () => pm.expect([200, 401]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
    }
